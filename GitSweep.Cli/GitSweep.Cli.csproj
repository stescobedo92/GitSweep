<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>gitsweep-cli</AssemblyName>
    <Version>0.0.0-local</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>gitsweep</ToolCommandName>
    <PackageId>GitSweep.Cli</PackageId>
    <Title>GitSweep</Title>
    <Authors>stescobedo92</Authors>
    <Description>Interactive Spectre.Console CLI for finding and cleaning stale or merged local Git branches.</Description>
    <PackageTags>git;cli;dotnet-tool;spectre-console;branch-cleanup;tui</PackageTags>
    <RepositoryUrl>https://github.com/stescobedo92/GitSweep</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/stescobedo92/GitSweep</PackageProjectUrl>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>binarycoffee.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
    <PackageReference Include="Spectre.Console" Version="0.55.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitSweep.Core\GitSweep.Core.csproj" />
    <ProjectReference Include="..\GitSweep.Infrastructure\GitSweep.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GitSweep.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
    <None Include="..\assets\binarycoffee.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
